# Production frontend variables. Copy this file to .env.production and replace placeholders.
# Vite exposes VITE_* values to the browser, so only publishable/non-secret values belong here.
# Keep worker secrets (SUPABASE_SERVICE_ROLE_KEY, ADMIN_TOKEN, etc.) in Cloudflare secrets.

# GitHub Pages base path used by the current production deployment.
VITE_BASE=/Maak/

# Public Cloudflare Worker API endpoint.
VITE_API_URL=https://maak.i36508871.workers.dev

# Supabase Auth/Data API endpoint and browser-safe publishable key.
VITE_SUPABASE_URL=https://pjvayowrmqkhmzvlhwex.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Keep demo/seed providers disabled in production.
VITE_INCLUDE_SEED=false

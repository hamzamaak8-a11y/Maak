# Copy to .env (local development) — see README.md.
# Only public client-side values belong here (EXPO_PUBLIC_* is embedded in the app bundle).
# NEVER put a service_role key or any secret in an EXPO_PUBLIC_* variable.

# Supabase project (Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>

# Public read API = the Cloudflare Worker in ./worker (marketplace listings + portfolio images)
# Official production Worker (Cloudflare account hamzamaak8@gmail.com):
# EXPO_PUBLIC_API_URL=https://maak.hamzamaak8.workers.dev
EXPO_PUBLIC_API_URL=https://maak.hamzamaak8.workers.dev

# ── Cloudflare Worker secrets (set with `wrangler secret put`, never committed) ──
# SUPABASE_SERVICE_ROLE_KEY   server-side only, bypasses RLS

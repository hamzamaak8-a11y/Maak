# Copy to .env.e2e locally and keep the real file untracked.
# SUPABASE_SERVICE_ROLE_KEY is server-side only and must never use a VITE_ prefix.
VITE_SUPABASE_URL=https://your-project.supabase.co
MAAK_E2E_PROVIDER_EMAIL=e2e-provider@maak.test
MAAK_E2E_PROVIDER_PASSWORD=replace-with-e2e-provider-password
MAAK_E2E_CUSTOMER_EMAIL=e2e-customer@maak.test
MAAK_E2E_CUSTOMER_PASSWORD=replace-with-e2e-customer-password
MAAK_E2E_ADMIN_EMAIL=e2e-admin@maak.test
MAAK_E2E_ADMIN_PASSWORD=replace-with-e2e-admin-password
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Leave unset for the local Vite server. Set to a deployed URL for remote E2E runs.
# MAAK_E2E_BASE_URL=http://127.0.0.1:4173

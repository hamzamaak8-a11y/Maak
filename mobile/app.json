{
  "expo": {
    "name": "Maak",
    "slug": "maak",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "maak",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maak.app"
    },
    "android": {
      "package": "com.maak.app",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
